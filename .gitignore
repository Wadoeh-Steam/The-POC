# macOS
.DS_Store

# Xcode build output (regenerate via xcodebuild, not checked in)
build/
build_device/
build_sim/
DerivedData/
*.xcuserstate
xcuserdata/

# EmotionPOC.xcodeproj is generated by `xcodegen generate` from project.yml —
# project.yml is the source of truth, not the generated project file.
EmotionPOC.xcodeproj/

# Supabase CLI local session state (project ref, pooler URL, tool versions
# for the linked project) — machine-local, regenerated by `supabase link`.
supabase/.temp/

# Never commit real secrets — API keys, DB passwords, service-role JWTs.
# The project already avoids writing these to files (see PLAN.md
# "Credential hygiene"); this is a backstop, not the only safeguard.
.env
.env.*
*.pem
*.key
